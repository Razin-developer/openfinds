# Copy this file to keystore.properties (git-ignored) and fill in real values
# to produce a signed release build/bundle. Generate a keystore with:
#   keytool -genkeypair -v -keystore release.keystore -alias openfind \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=/absolute/path/to/release.keystore
storePassword=CHANGE_ME
keyAlias=openfind
keyPassword=CHANGE_ME
