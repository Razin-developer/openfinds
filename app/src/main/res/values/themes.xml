<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Compose owns all real theming (Theme.kt); this
         XML theme only needs to exist so the manifest has a valid android:theme
         before Compose content is set. -->
    <style name="Theme.OpenFind" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.OpenFind.Splash" parent="Theme.OpenFind">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen" tools:targetApi="31">false</item>
    </style>
</resources>
